# --- CORE GAME ENGINE (Keeper & companions) ---
# Options: google, openrouter, ollama
LLM_PROVIDER=openrouter
LLM_MODEL=x-ai/grok-4.20

# --- SCENARIO ARCHITECT (Scripter) ---
# Optional overrides; falls back to LLM_PROVIDER / LLM_MODEL.
# SCRIPTER_PROVIDER=google
# SCRIPTER_MODEL=gemini-2.0-flash

# --- UTILITY MODEL (cheap tasks: memory summaries, lore handouts) ---
# Optional; falls back to the main model. Use a cheap/fast model to save tokens.
# UTILITY_PROVIDER=openrouter
# UTILITY_MODEL=google/gemini-3.1-flash-lite

# --- API KEYS ---
GOOGLE_API_KEY=your_google_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# --- OLLAMA (optional) ---
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- DEV: play offline with a scripted fake keeper (no API key needed) ---
# MOCK_LLM=1
