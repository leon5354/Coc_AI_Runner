# The easiest way to pick a brain is in the app: Settings. The first two need no key.
#   ollama      a model on your own GPU (free, private)
#   claude_cli  your Claude subscription, after `claude auth login` once
#   openrouter / google   online APIs, pay per use, need a key below
# --- CORE GAME ENGINE (Keeper & companions) ---
LLM_PROVIDER=ollama
LLM_MODEL=

# --- SCENARIO ARCHITECT (Scripter) ---
# Optional overrides; falls back to LLM_PROVIDER / LLM_MODEL.
# SCRIPTER_PROVIDER=google
# SCRIPTER_MODEL=gemini-2.0-flash

# --- UTILITY MODEL (cheap tasks: memory summaries, lore handouts) ---
# Optional; falls back to the main model.
# UTILITY_PROVIDER=ollama
# UTILITY_MODEL=

# --- API KEYS ---
# Only for the online APIs:
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=

# --- OLLAMA (optional) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_CTX=16384

# --- DEV: play offline with a scripted fake keeper (no API key needed) ---
# MOCK_LLM=1
